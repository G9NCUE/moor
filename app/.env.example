# Copy to .env.local. Everything is optional; the app runs with none of it.

# Dev only: skips onboarding and unlocks this phrase, so two simulators share a seed.
# Eliminated from release builds (verified against a production export), but it sits in
# plaintext on disk, in shell history and in `ps`. Throwaway phrases only. While it is set
# the onboarding screens are unreachable; leave it blank to exercise them.
EXPO_PUBLIC_DEV_SEED=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# Blind peer(s) to mirror the address book to, comma-separated. Blank uses the one we run.
EXPO_PUBLIC_BLIND_PEERS=

# Arbitrum RPC. Blank uses the public pool.
EXPO_PUBLIC_ARBITRUM_PROVIDER=

# ERC-4337 bundler. Default is Pimlico's public endpoint; Candide's cannot submit
# EntryPoint v0.8. Use an authenticated endpoint for anything real.
EXPO_PUBLIC_ARBITRUM_BUNDLER_URL=

# ERC-7677 paymaster. Default is Candide's public, rate-limited endpoint.
EXPO_PUBLIC_ARBITRUM_PAYMASTER_URL=

# EIP-7702 delegation contract. Default verified by lab/t5; verify it yourself before real money.
EXPO_PUBLIC_ARBITRUM_DELEGATION_ADDRESS=

# 1 builds the self-paid-gas variant. Must match the bundle: MOOR_SELF_GAS=1 npx wdk-worklet-bundler generate
EXPO_PUBLIC_MOOR_SELF_GAS=
