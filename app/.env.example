# Copy to .env.local and fill in. All values are optional — the app runs without any.

# ─────────────────────────────────────────────────────────────────────────────
# Dev-only: skip onboarding and unlock a fixed recovery phrase, so two
# simulators can be put on the same seed without anyone tapping through twice.
#
# THROWAWAY PHRASES ONLY. Never a phrase holding money you care about.
#
# What we checked, so you don't have to take it on trust: the phrase does NOT
# reach a release build. `__DEV__` is false there and the branch is eliminated
# before the value is inlined — verified by grepping a real production export,
# which contains neither the phrase nor this variable's name.
#
# What is still true: it sits in plaintext on your disk, in your shell history
# if you set it inline, in `ps`, and inside the dev bundle Metro serves. Any of
# those is enough to lose the funds on it.
#
# The default below is the publicly known BIP-39 test vector. It holds nothing
# precisely because everybody has it.
EXPO_PUBLIC_DEV_SEED=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about
# ─────────────────────────────────────────────────────────────────────────────

# Blind peer(s) to mirror the address book to. Comma-separated pool.
# LEAVE BLANK to use the one we run (a4z9rgfq…qpd1o) — two-device sync then works
# out of the box. Override to point at your own: cd infra/blind-peer && npm start
EXPO_PUBLIC_BLIND_PEERS=

# Arbitrum RPC. Defaults to the public endpoint.
EXPO_PUBLIC_ARBITRUM_PROVIDER=

# ERC-4337 bundler — submits the operation. Defaults to Pimlico's public endpoint.
# Not Candide: its public bundler cannot submit EntryPoint v0.8 operations, which is what
# EIP-7702 needs. Use an authenticated endpoint for anything real.
EXPO_PUBLIC_ARBITRUM_BUNDLER_URL=

# ERC-7677 paymaster — pays the ETH and takes USD₮ for it. Defaults to Candide's public,
# rate-limited endpoint: https://dashboard.candide.dev
EXPO_PUBLIC_ARBITRUM_PAYMASTER_URL=

# EIP-7702 delegation contract. Defaults to a value verified by lab/t5.
# Verify it yourself before trusting real money to it.
EXPO_PUBLIC_ARBITRUM_DELEGATION_ADDRESS=

# Set to 1 to build the self-paid-gas variant (user needs ETH).
# Must match the bundle: MOOR_SELF_GAS=1 npx wdk-worklet-bundler generate
EXPO_PUBLIC_MOOR_SELF_GAS=
